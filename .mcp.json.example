{
  "_comment": "EXEMPLO. Copie para .mcp.json (ignorado pelo Git) somente após ler docs/pipeline/MCP_SECURITY.md. Nenhum MCP é habilitado por padrão.",
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
